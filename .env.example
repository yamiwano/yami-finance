# Copy to .env and adjust. Docker Compose reads this file.
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=opportunity_radar
DATABASE_URL=postgresql+asyncpg://radar:radar@postgres:5432/opportunity_radar
REDIS_URL=redis://redis:6379/0

# --- Scanner ---
# binance (default, live) | mock (offline UI only)
MARKET_DATA_PROVIDER=binance
SCAN_INTERVAL_SECONDS=2
FULL_RESCAN_SECONDS=60
MIN_OPPORTUNITY_SCORE=55
UNIVERSE_SIZE=48
MIN_QUOTE_VOLUME_USDT=15000000
BINANCE_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision/stream

# --- AI explanations (optional) ---
# mock | openai | anthropic
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MIN_SCORE=65

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
CORS_ORIGINS=http://localhost:3000
